# Copy this file to .env and edit as needed.
# .env is git-ignored – never commit secrets.

# LLM endpoint. Use the DGX Spark IP when in India.
LLM_BASE_URL=http://ollama-service:11434/v1
LLM_MODEL=llama3

# Qdrant vector database
VECTOR_DB_URL=http://qdrant:6333
VECTOR_COLLECTION=school_docs

# RACHEL server
RACHEL_URL=http://rachel-server.local
RACHEL_LIBRARY_PATH=/library

# Local path where PDFs are stored (inside the container)
DOCS_PATH=/app/data
